{
    "private": true,
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.php": [
            "php ./vendor/bin/php-cs-fixer fix --config .php_cs",
            "git add"
        ]
    }
}
